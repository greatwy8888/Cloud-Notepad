{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-notepad-v6",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloud-notepad-v6-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "cloud-notepad-v6-files"
    }
  ]
}